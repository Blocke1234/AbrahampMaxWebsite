# ============================================================
# Big Willie Style — environment variables
# Copy to .env.local (gitignored) and fill in.
# Also add each of these in Vercel > Project > Settings > Environment Variables.
#
# 🔓 PUBLIC  = safe to expose, ships to the browser. Claude fills these in.
# 🔒 SECRET  = server-only. NEVER commit, never paste into chat. Blake fills these in.
# ============================================================

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=https://bigwilliestyle.co

# ---------- Existing ad pixels (already live, do not remove) ----------
# 🔓 Google Analytics 4 measurement ID
NEXT_PUBLIC_GA_ID=
# 🔓 Meta (Facebook/Instagram) pixel ID
NEXT_PUBLIC_META_PIXEL_ID=
# 🔓 TikTok pixel ID
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
# 🔓 Google Search Console verification
GOOGLE_SITE_VERIFICATION=

# ---------- PostHog (product analytics) ----------
# 🔓 Project API key — PostHog > Settings > Project > Project API Key ("phc_...")
NEXT_PUBLIC_POSTHOG_KEY=
# 🔓 Reverse-proxied through /ingest to survive ad blockers. Leave as-is.
NEXT_PUBLIC_POSTHOG_HOST=/ingest
# 🔓 Used only to build "view in PostHog" links
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com

# ---------- Sentry (error tracking) ----------
# 🔓 DSN is public by design — Sentry > Settings > Projects > Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=
# 🔓 Org + project slugs, used at build time for source map upload
SENTRY_ORG=
SENTRY_PROJECT=
# 🔒 Build-time token for uploading source maps.
#    Sentry > Settings > Auth Tokens. The wizard writes this to
#    .env.sentry-build-plugin (now gitignored) — you do NOT need to paste it here
#    unless building on Vercel, where it must be added as an env var.
SENTRY_AUTH_TOKEN=

# ---------- Stripe (payments — Payment Link model, no on-site checkout) ----------
# 🔓 Publishable key — Stripe > Developers > API keys ("pk_test_..." / "pk_live_...")
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# 🔒 Secret key — same page, "Reveal test key" ("sk_test_..." / "sk_live_...")
STRIPE_SECRET_KEY=
# 🔒 Webhook signing secret — Stripe > Developers > Webhooks > your endpoint ("whsec_...")
#    For local testing, `stripe listen` prints a temporary one.
STRIPE_WEBHOOK_SECRET=
# 🔓 The hosted Payment Link URL for The Come-Up ($199)
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=
# 🔓 The hosted Payment Link URL for the neck massager ($89.99)
NEXT_PUBLIC_STRIPE_NECK_MASSAGER_LINK=

# ---------- Resend (transactional email) ----------
# 🔒 API key — Resend > API Keys > Create ("re_...")
RESEND_API_KEY=
# 🔓 From address. Requires bigwilliestyle.co verified in Resend (DKIM/SPF via Cloudflare).
RESEND_FROM_EMAIL="Big Willie Style <hello@bigwilliestyle.co>"
# 🔓 Where contact-form notifications land
CONTACT_NOTIFY_EMAIL=

# ---------- Upstash Redis (rate limiting + webhook idempotency) ----------
# 🔓 REST URL — Upstash > your database > REST API
UPSTASH_REDIS_REST_URL=
# 🔒 REST token — same panel. Treat as a password.
UPSTASH_REDIS_REST_TOKEN=

# ---------- Pinecone (vector DB — account only for now, no index yet) ----------
# 🔒 API key — Pinecone > API Keys
PINECONE_API_KEY=
